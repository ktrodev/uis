local active_tweens = setmetatable({}, { __mode = 'k' })
local function create_tween(instance, info, properties)
	local running = active_tweens[instance]
	if not running then
		running = {}
		active_tweens[instance] = running
		instance.Destroying:Once(function()
			local cancelled = {}
			for _, tween in pairs(running) do
				if not cancelled[tween] then cancelled[tween] = true; tween:Cancel() end
			end
			table.clear(running)
			active_tweens[instance] = nil
		end)
	end
	local cancelled = {}
	for property in pairs(properties) do
		local previous = running[property]
		if previous and not cancelled[previous] then cancelled[previous] = true; previous:Cancel() end
	end
	local tween = tween_service:Create(instance, info, properties)
	for property in pairs(properties) do running[property] = tween end
	tween.Completed:Once(function()
		for property in pairs(properties) do
			if running[property] == tween then running[property] = nil end
		end
	end)
	return tween
end

local function set_properties(instance, properties)
	local running = active_tweens[instance]
	if running then
		local cancelled = {}
		for property in pairs(properties) do
			local tween = running[property]
			if tween and not cancelled[tween] then cancelled[tween] = true; tween:Cancel() end
		end
	end
	for property, value in pairs(properties) do instance[property] = value end
end

