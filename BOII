local share_codec = {
	PREFIX = 'R2',
	MAX_CODE_LENGTH = 100000,
	MAX_RECORDS = 2048,
}
do
	local base36 = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'
	local flag_modulus = 2176782336

	function share_codec.encode_base36(value: number, minimum_width: number?)
		if type(value) ~= 'number' or value ~= value or value < 0 or value == math.huge then
			return nil
		end
		value = math.floor(value)
		local output = ''
		repeat
			local index = (value % 36) + 1
			output = base36:sub(index, index) .. output
			value = math.floor(value / 36)
		until value == 0
		while #output < (minimum_width or 0) do
			output = '0' .. output
		end
		return output
	end

	function share_codec.decode_base36(value: string)
		if type(value) ~= 'string' or value == '' or not value:match('^[0-9A-Z]+$') then
			return nil
		end
		local result = 0
		for index = 1, #value do
			local digit = base36:find(value:sub(index, index), 1, true)
			if not digit then
				return nil
			end
			result = result * 36 + digit - 1
			if result > 9007199254740991 then
				return nil
			end
		end
		return result
	end

	function share_codec.escape(value: string)
		value = tostring(value or '')
		local output = table.create(#value)
		for index = 1, #value do
			local byte = value:byte(index)
			local character = value:sub(index, index)
			if byte < 32 or byte > 126 or character == '%' or character == '|' or character == '=' or character == '~' then
				output[#output + 1] = string.format('%%%02X', byte)
			else
				output[#output + 1] = character
			end
		end
		return table.concat(output)
	end

	function share_codec.unescape(value: string)
		if type(value) ~= 'string' then
			return nil, 'encoded value is not a string'
		end
		local output = table.create(#value)
		local index = 1
		while index <= #value do
			local character = value:sub(index, index)
			if character == '%' then
				local hexadecimal = value:sub(index + 1, index + 2)
				if #hexadecimal ~= 2 or not hexadecimal:match('^[0-9A-F][0-9A-F]$') then
					return nil, 'invalid percent escape'
				end
				local decoded_byte = tonumber(hexadecimal, 16)
				local decoded_character = string.char(decoded_byte)
				if decoded_byte >= 32 and decoded_byte <= 126 and decoded_character ~= '%' and decoded_character ~= '|' and decoded_character ~= '=' and decoded_character ~= '~' then
					return nil, 'unnecessary percent escape'
				end
				output[#output + 1] = decoded_character
				index += 3
			else
				output[#output + 1] = character
				index += 1
			end
		end
		return table.concat(output)
	end

	function share_codec.checksum(value: string)
		local a, b = 1, 0
		for index = 1, #value do
			a = (a + value:byte(index)) % 65521
			b = (b + a) % 65521
		end
		return b * 65536 + a
	end

	function share_codec.flag_id(flag: string)
		local hash = 7
		for index = 1, #flag do
			hash = (hash * 131 + flag:byte(index)) % flag_modulus
		end
		return share_codec.encode_base36(hash, 6)
	end

	function share_codec.encode_value(value: any)
		local value_type = type(value)
		if value_type == 'boolean' then
			return value and 'b1' or 'b0'
		elseif value_type == 'number' then
			if value ~= value or value == math.huge or value == -math.huge then
				return nil, 'numbers must be finite'
			end
			if value % 1 == 0 and math.abs(value) <= 9007199254740991 then
				local sign = value < 0 and '-' or ''
				return 'i' .. sign .. share_codec.encode_base36(math.abs(value))
			end
			return 'n' .. share_codec.escape(string.format('%.17g', value))
		elseif value_type == 'string' then
			return 's' .. share_codec.escape(value)
		elseif value_type == 'table' then
			local success, encoded = pcall(function()
				return http_service:JSONEncode(value)
			end)
			if not success then
				return nil, 'table is not JSON serializable'
			end
			return 'j' .. share_codec.escape(encoded)
		end
		return nil, 'unsupported value type ' .. value_type
	end

	function share_codec.decode_value(encoded: string)
		if type(encoded) ~= 'string' or #encoded < 1 then
			return nil, 'missing typed value'
		end
		local tag = encoded:sub(1, 1)
		local payload = encoded:sub(2)
		if tag == 'b' then
			if payload == '1' then return true end
			if payload == '0' then return false end
			return nil, 'invalid boolean'
		elseif tag == 'i' then
			local negative = payload:sub(1, 1) == '-'
			if negative then payload = payload:sub(2) end
			if (#payload > 1 and payload:sub(1, 1) == '0') or (negative and payload == '0') then
				return nil, 'non-canonical integer'
			end
			local value = share_codec.decode_base36(payload)
			if value == nil then return nil, 'invalid integer' end
			return negative and -value or value
		elseif tag == 'n' then
			local decoded, decode_error = share_codec.unescape(payload)
			if not decoded then return nil, decode_error end
			local value = tonumber(decoded)
			if value == nil or value ~= value or value == math.huge or value == -math.huge then
				return nil, 'invalid decimal'
			end
			if value % 1 == 0 and math.abs(value) <= 9007199254740991 then
				return nil, 'integer used decimal encoding'
			end
			if 'n' .. share_codec.escape(string.format('%.17g', value)) ~= encoded then
				return nil, 'non-canonical decimal'
			end
			return value
		elseif tag == 's' then
			return share_codec.unescape(payload)
		elseif tag == 'j' then
			local decoded, decode_error = share_codec.unescape(payload)
			if not decoded then return nil, decode_error end
			local success, value = pcall(function()
				return http_service:JSONDecode(decoded)
			end)
			if not success or type(value) ~= 'table' then
				return nil, 'invalid table'
			end
			return value
		end
		return nil, 'unknown value type'
	end
end
local function deep_copy_serialize(value: any, seen: any?, depth: number?)
	depth = depth or 0
	seen = seen or {}
	seen._nodes = (seen._nodes or 0) + 1
	if seen._nodes > 20000 then error('config contains too many values') end
	if type(value) == 'string' and #value > 100000 then error('config string is too large') end
	if depth > 32 then
		error('config nesting is too deep')
	end
	local value_type = typeof(value)
	if value_type == 'Color3' then
		return { __pivot_type = 'Color3', __roni_type = 'Color3', values = { value.R, value.G, value.B } }
	elseif value_type == 'Vector2' then
		return { __pivot_type = 'Vector2', __roni_type = 'Vector2', values = { value.X, value.Y } }
	elseif value_type == 'Vector3' then
		return { __pivot_type = 'Vector3', __roni_type = 'Vector3', values = { value.X, value.Y, value.Z } }
	elseif value_type == 'CFrame' then
		return { __pivot_type = 'CFrame', __roni_type = 'CFrame', values = { value:GetComponents() } }
	elseif value_type == 'EnumItem' then
		return { __pivot_type = 'EnumItem', __roni_type = 'EnumItem', enum = tostring(value) }
	elseif value_type ~= 'table' then
		if value_type == 'number' and (value ~= value or value == math.huge or value == -math.huge) then
			error('config numbers must be finite')
		end
		if value_type == 'nil' or value_type == 'boolean' or value_type == 'number' or value_type == 'string' then
			return value
		end
		error('unsupported config value type ' .. value_type)
	end

	seen = seen or {}
	if seen[value] then
		error('config tables cannot contain cycles')
	end
	seen[value] = true
	local copy = {}
	local count = 0
	for key, child in pairs(value) do
		count += 1
		if count > 10000 then
			error('config table is too large')
		end
		local key_type = type(key)
		if key_type == 'string' or key_type == 'number' then
			local serialized_child = deep_copy_serialize(child, seen, depth + 1)
			if serialized_child ~= nil then
				copy[key] = serialized_child
			end
		end
	end
	seen[value] = nil
	return copy
end

local function deep_copy_deserialize(value: any, depth: number?)
	depth = depth or 0
	if depth > 32 then error('config nesting is too deep') end
	if type(value) ~= 'table' then return value end
	local tagged_values = value.values
	if (value.__pivot_type == 'Color3' or value.__roni_type == 'Color3') and type(tagged_values) == 'table' and type(tagged_values[1]) == 'number' and type(tagged_values[2]) == 'number' and type(tagged_values[3]) == 'number' then
		return Color3.new(tagged_values[1], tagged_values[2], tagged_values[3])
	elseif (value.__pivot_type == 'Vector2' or value.__roni_type == 'Vector2') and type(tagged_values) == 'table' and type(tagged_values[1]) == 'number' and type(tagged_values[2]) == 'number' then
		return Vector2.new(tagged_values[1], tagged_values[2])
	elseif (value.__pivot_type == 'Vector3' or value.__roni_type == 'Vector3') and type(tagged_values) == 'table' and type(tagged_values[1]) == 'number' and type(tagged_values[2]) == 'number' and type(tagged_values[3]) == 'number' then
		return Vector3.new(tagged_values[1], tagged_values[2], tagged_values[3])
	elseif (value.__pivot_type == 'CFrame' or value.__roni_type == 'CFrame') and type(tagged_values) == 'table' and #tagged_values == 12 then
		return CFrame.new(table.unpack(tagged_values))
	elseif (value.__pivot_type == 'EnumItem' or value.__roni_type == 'EnumItem') and type(value.enum) == 'string' then
		local enum_str = value.enum
		local key_name = enum_str:gsub('^Enum%.KeyCode%.', '')
		local ok, kc = pcall(function() return Enum.KeyCode[key_name] end)
		if ok and kc then return kc end
		local enum_type, item_name = enum_str:match('^Enum%.([^%.]+)%.([^%.]+)$')
		if enum_type and item_name then
			local ok2, item = pcall(function() return Enum[enum_type][item_name] end)
			if ok2 and item then return item end
		end
		return enum_str
	end
	local copy = {}
	for key, child in pairs(value) do
		copy[key] = deep_copy_deserialize(child, depth + 1)
	end
	return copy
end

local function clone_config_value(value: any)
	if value == nil then
		return nil
	end
	local success, serialized = pcall(function()
		return deep_copy_serialize(value)
	end)
	if not success then
		return nil, tostring(serialized)
	end
	return deep_copy_deserialize(serialized)
end

local function clean_config(data)
	if type(data) ~= 'table' then return nil, 'config must be a table' end
	local flags, keybinds, extra = data._flags, data._keybinds, data._library
	if flags == nil then flags, keybinds = data.f or data.flags, data.k or data.keybinds end
	if type(flags) ~= 'table' or (keybinds ~= nil and type(keybinds) ~= 'table')
		or (extra ~= nil and type(extra) ~= 'table') then
		return nil, 'config must contain settings and optional keybind tables'
	end
	local ok, copy = pcall(function()
		return deep_copy_deserialize(deep_copy_serialize({ _flags = flags, _keybinds = keybinds or {}, _library = extra or {} }))
	end)
	if not ok then return nil, tostring(copy) end
	for flag, saved in pairs(copy._flags) do
		if type(flag) ~= 'string' or #flag == 0 or #flag > 256 or flag:find('%c') then
			return nil, 'invalid setting name'
		end
		local legacy = type(saved) == 'table' and type(saved.checked) == 'boolean'
		if legacy then
			for key in pairs(saved) do
				if key ~= 'checked' and key ~= 'BIND' then legacy = false; break end
			end
		end
		if legacy then
			copy._flags[flag] = saved.checked
			if type(saved.BIND) == 'string' and saved.BIND ~= '' and saved.BIND ~= 'Unknown' then
				copy._keybinds[flag] = saved.BIND
			end
		end
	end
	for flag, key in pairs(copy._keybinds) do
		if type(flag) ~= 'string' or #flag == 0 or #flag > 256 or flag:find('%c') then
			return nil, 'invalid keybind setting name'
		end
		if typeof(key) == 'EnumItem' then key = tostring(key) end
		if type(key) ~= 'string' or #key > 80 then return nil, 'invalid saved keybind' end
		local name = key:gsub('^Enum%.KeyCode%.', '')
		if name == '' or name == 'None' or name == 'Unknown' then copy._keybinds[flag] = 'None'
		else
			local ok, item = pcall(function() return Enum.KeyCode[name] end)
			if not ok or not item then return nil, 'invalid saved keybind for ' .. flag end
			copy._keybinds[flag] = 'Enum.KeyCode.' .. item.Name
		end
	end
	return copy
end

