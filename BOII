				opts = opts or {}
				state = state == true
				if library:values_equal(self._state, state) and not opts.force_callback then
					return false
				end

				self._state = state
				if not self._state then
					for _, dd in ipairs(library._active_dropdowns) do
						if dd._state and dd._module == module_manager then
							dd:unfold_settings({ animate = false })
						end
					end
				end

				local target_height = self._state and get_expanded_height() or 72
				local toggle_color = self._state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(38, 38, 38)
				local circle_color = self._state and Color3.fromRGB(18, 18, 18) or Color3.fromRGB(180, 180, 180)
				local circle_position = self._state and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)

				if self._state then
					module_options.Visible = true
				end

				apply_module_height(target_height, opts.animate ~= false, 0.4)
				if opts.animate ~= false then
					create_tween(Toggle, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
						BackgroundColor3 = toggle_color
					}):Play()
					create_tween(circle, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
						BackgroundColor3 = circle_color,
						Position = circle_position
					}):Play()
				else
					set_properties(Toggle, { BackgroundColor3 = toggle_color })
					set_properties(circle, { BackgroundColor3 = circle_color, Position = circle_position })
				end

				library._config._flags[settings.flag] = self._state
				if opts.persist ~= false and module_persistent then
					Config:save(game.GameId, library._config)
				end
				if opts.callback ~= false and settings.callback then
					settings.callback(self._state)
				end
				return true
			end
			library:register_flag(settings.flag, 'boolean', {
				default = false,
				persist = module_persistent,
				export = module_exportable == true and not library:_is_internal_flag(settings.flag),
				priority = 10
			})
			local initial_module_state = module_persistent and library:flag_type(settings.flag, 'boolean') and library._config._flags[settings.flag] or false
			module_manager._state = not initial_module_state
			library:register_component(settings.flag, function(value, opts)
