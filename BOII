local function get_http_request()
	if type(request) == 'function' then
		return request
	end
	if type(http_request) == 'function' then
		return http_request
	end
	if type(syn) == 'table' and type(syn.request) == 'function' then
		return syn.request
	end
	if type(http) == 'table' and type(http.request) == 'function' then
		return http.request
	end
	return nil
end
local function boot_post(session: any, path: string)
	local http_fn = get_http_request()
	if not http_fn or type(session.origin) ~= 'string' or type(session.token) ~= 'string' then
		return nil
	end
	local ok_body, body = pcall(function()
		return http_service:JSONEncode({
			token = session.token,
			device = session.device or '',
			place = tonumber(session.place) or 0,
			creator = tonumber(session.creator) or 0,
			user = tonumber(session.user) or 0,
		})
	end)
	if not ok_body then
		return nil
	end
	local ok, response = pcall(http_fn, {
		Url = session.origin .. path,
		Method = 'POST',
		Headers = { ['Content-Type'] = 'application/json' },
		Body = body,
	})
	if not ok or type(response) ~= 'table' then
		return nil
	end
	local status = tonumber(response.StatusCode or response.Status) or 0
	local ok_decode, data = pcall(function()
		return http_service:JSONDecode(response.Body or response.body or '')
	end)
	if not ok_decode or type(data) ~= 'table' then
		return nil, status
	end
	return data, status
end
function library:fetch_profile(force: boolean?)
	local state = library.Luarmor.remote_state
	if state == 'loading' or (state == 'done' and not force) then
		return false
	end
	local session = get_boot_session()
	if not session or type(session.token) ~= 'string' or type(session.origin) ~= 'string' then
		library.Luarmor.remote_state = 'unavailable'
		return false
	end
	library.Luarmor.remote_state = 'loading'
	task.spawn(function()
		local ok = pcall(function()
			local data = boot_post(session, '/v1/profile')
			if type(data) == 'table' and data.code == 'OK' then
				library.Luarmor.remote = data
				library.Luarmor.remote_state = 'done'
				return
			end
			if type(session.tier) ~= 'string' then
				local meta = boot_post(session, '/v1/meta')
				if type(meta) == 'table' and meta.code == 'OK' and type(meta.tier) == 'string' then
					library.Luarmor.remote = { tier = meta.tier }
				end
			end
			library.Luarmor.remote_state = 'unavailable'
		end)
		if not ok then
			library.Luarmor.remote_state = 'unavailable'
		end
		pcall(function()
			library:refresh_profile()
		end)
	end)
	return true
end
function library:refresh_profile()
