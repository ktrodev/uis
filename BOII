	if not label or not label.Set then
		return
	end
	local text, info = lib:_profile_lines()
	pcall(function() label:Set({ text = text }) end)
	if info.seconds_left ~= nil and not info.lifetime and lib._start_profile_timer then
		lib._start_profile_timer()
