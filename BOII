	options = type(options) == 'table' and options or {}
	local data, data_error = clean_config({ _flags = flags, _keybinds = keybinds or {} })
	if not data then return { ok = false, applied = 0, errors = { data_error } } end
	self._apply_queue = self._apply_queue or {}
