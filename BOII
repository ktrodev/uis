function translator:detect_locale()
	local locale = nil
	pcall(function()
		if self._roblox_translator and self._roblox_translator.LocaleId and self._roblox_translator.LocaleId ~= '' then
			locale = tostring(self._roblox_translator.LocaleId):lower():gsub('_', '-')
		elseif players.LocalPlayer and players.LocalPlayer.LocaleId and players.LocalPlayer.LocaleId ~= '' then
			locale = tostring(players.LocalPlayer.LocaleId):lower():gsub('_', '-')
		elseif localization_service and localization_service.RobloxLocaleId and localization_service.RobloxLocaleId ~= '' then
			locale = tostring(localization_service.RobloxLocaleId):lower():gsub('_', '-')
		end
	end)
	locale = locale or 'en'
	if locale:find('^zh') then
		return 'zh-CN'
	end
	local prefix = locale:match('^([a-z]+)')
	if prefix and (language_code_map[code_to_name_map[prefix] or ''] or table.find(language_options, code_to_name_map[prefix])) then
		return prefix
	end
	return 'en'
end

function translator:load_cache(lang: string)
	if self._cache_loaded[lang] then return end
	self._cache_loaded[lang] = true
	self._cache[lang] = self._cache[lang] or {}
	local path = pivot_root .. '/cache/translations_' .. tostring(lang) .. '.json'
	local content = fs_read(path)
	if content and content ~= '' then
		do
			local ok_dec, decoded = pcall(function() return http_service:JSONDecode(content) end)
			if ok_dec and type(decoded) == 'table' then
				for k, v in pairs(decoded) do
					if type(k) == 'string' and type(v) == 'string' then
						self._cache[lang][k] = v
					end
				end
			end
		end
	end
end

function translator:save_cache(lang: string)
	if type(writefile) ~= 'function' or not self._cache[lang] or self._save_debounce[lang] then return end
	self._save_debounce[lang] = true
	task.delay(1.5, function()
		self._save_debounce[lang] = nil
		local ok, encoded = pcall(function()
			return http_service:JSONEncode(self._cache[lang] or {})
		end)
		if ok then
			fs_write(pivot_root .. '/cache/translations_' .. tostring(lang) .. '.json', encoded)
		end
	end)
end

function translator:request_http(url: string)
	local req = (typeof(request) == 'function' and request) or (typeof(http_request) == 'function' and http_request) or (syn and syn.request) or (fluxus and fluxus.request) or (http and http.request)
	if req then
		local ok, res = pcall(req, { Url = url, Method = 'GET', Headers = { ['User-Agent'] = 'Mozilla/5.0' } })
		if ok and res and (res.StatusCode == 200 or res.Status == 200 or res.Success) then
			return res.Body or res.body
		end
	end
	local ok_get, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok_get and body and body ~= '' then
		return body
	end
	local ok_svc, svc_res = pcall(function()
		return http_service:GetAsync(url)
	end)
	if ok_svc and svc_res and svc_res ~= '' then
		return svc_res
	end
	return nil
end

local translate_providers = {
	function(self, text, lang)
		local url = 'https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=auto&tl=' .. http_service:UrlEncode(lang) .. '&q=' .. http_service:UrlEncode(text)
		local body = self:request_http(url)
		if type(body) ~= 'string' or body:sub(1, 1) ~= '[' then return nil end
		local ok, data = pcall(function() return http_service:JSONDecode(body) end)
		if not ok or type(data) ~= 'table' then return nil end
		local first = data[1]
		if type(first) == 'table' and type(first[1]) == 'string' then return first[1] end
		if type(first) == 'string' then return first end
		return nil
	end,
	function(self, text, lang)
		local url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=' .. http_service:UrlEncode(lang) .. '&dt=t&q=' .. http_service:UrlEncode(text)
		local body = self:request_http(url)
		if type(body) ~= 'string' or body:sub(1, 1) ~= '[' then return nil end
		local ok, data = pcall(function() return http_service:JSONDecode(body) end)
		if not ok or type(data) ~= 'table' or type(data[1]) ~= 'table' then return nil end
		local combined = ''
		for _, seg in ipairs(data[1]) do
			if type(seg) == 'table' and type(seg[1]) == 'string' then
				combined = combined .. seg[1]
			end
		end
		return combined ~= '' and combined or nil
	end,
	function(self, text, lang)
		local url = 'https://api.mymemory.translated.net/get?q=' .. http_service:UrlEncode(text) .. '&langpair=en%7C' .. http_service:UrlEncode(lang)
		local body = self:request_http(url)
		if type(body) ~= 'string' or body:sub(1, 1) ~= '{' then return nil end
		local ok, data = pcall(function() return http_service:JSONDecode(body) end)
		if not ok or type(data) ~= 'table' or data.quotaFinished == true then return nil end
		local rd = data.responseData
		if type(rd) == 'table' and type(rd.translatedText) == 'string' and rd.translatedText ~= '' and not rd.translatedText:find('MYMEMORY WARNING', 1, true) then
			return rd.translatedText
		end
		return nil
	end,
}

translator._provider_fail = {}
translator._provider_cooldown = {}

function translator:translate_raw(text: string, target_lang: string, callback: any)
	if target_lang == 'en' or text == '' or tonumber(text) ~= nil then
		callback(text)
		return
	end
	for index, provider in ipairs(translate_providers) do
		local until_time = self._provider_cooldown[index]
		if not until_time or os.clock() >= until_time then
			local ok, result = pcall(provider, self, text, target_lang)
			if ok and type(result) == 'string' and result ~= '' then
				self._provider_fail[index] = 0
				callback(result)
				return
			end
			local fails = (self._provider_fail[index] or 0) + 1
			self._provider_fail[index] = fails
			if fails >= 3 then
				self._provider_cooldown[index] = os.clock() + math.min(300, 20 * fails)
			end
		end
	end
	if self._roblox_translator then
		local ok, roblox_res = pcall(function()
			return self._roblox_translator:Translate(game, text)
		end)
		if ok and type(roblox_res) == 'string' and roblox_res ~= '' then
			callback(roblox_res)
			return
		end
	end
	callback(text)
end

function translator:process_queue()
	if self._queue_active or #self._queue == 0 then return end
	self._queue_active = true
	task.spawn(function()
		while #self._queue > 0 do
			local item = table.remove(self._queue, 1)
			if item.lang ~= self._current_lang then
				for _, cb in ipairs(item.callbacks) do
					pcall(cb, item.text)
				end
				continue
			end
			local lang = item.lang
			local text = item.text
			self._cache[lang] = self._cache[lang] or {}
			if self._cache[lang][text] then
				for _, cb in ipairs(item.callbacks) do
					pcall(cb, self._cache[lang][text])
				end
			else
				self:translate_raw(text, lang, function(translated)
					if translated and translated ~= text and translated ~= '' then
						self._cache[lang][text] = translated
						self:save_cache(lang)
					end
					for _, cb in ipairs(item.callbacks) do
						pcall(cb, translated)
					end
				end)
				task.wait(0.12)
			end
		end
		self._queue_active = false
	end)
end

function translator:queue_translate(text: string, lang: string, callback: any)
	self._cache[lang] = self._cache[lang] or {}
	if self._cache[lang][text] then
		callback(self._cache[lang][text])
		return
	end
	for _, item in ipairs(self._queue) do
		if item.text == text and item.lang == lang then
			table.insert(item.callbacks, callback)
			return
		end
	end
	table.insert(self._queue, {
		text = text,
		lang = lang,
		callbacks = { callback }
	})
	self:process_queue()
end

function translator:apply_binding(entry: any)
	local inst = entry.instance
	if not inst then return end
	local is_alive = pcall(function() return inst.Parent end)
	if not is_alive then return end

	local lang = self._current_lang
	local raw = entry.raw
	if lang == 'en' then
		local val = raw
		if entry.transform then val = entry.transform(val) end
		pcall(function() inst[entry.property] = val end)
		return
	end
	self._cache[lang] = self._cache[lang] or {}
	local cached = self._cache[lang][raw]
	if cached then
		local val = cached
		if entry.transform then val = entry.transform(val) end
		pcall(function() inst[entry.property] = val end)
		return
	end
	local fallback = raw
	if entry.transform then fallback = entry.transform(fallback) end
	pcall(function() inst[entry.property] = fallback end)

	self:queue_translate(raw, lang, function(translated)
		if inst and self._current_lang == lang then
			local still_alive = pcall(function() return inst.Parent end)
			if still_alive then
				local val = translated
				if entry.transform then val = entry.transform(val) end
				pcall(function() inst[entry.property] = val end)
			end
		end
	end)
end

function translator:bind(instance: Instance, raw_text: string?, property: string?, transform: any?)
	if not instance or type(raw_text) ~= 'string' or raw_text == '' then return end
	property = property or 'Text'
	local entry = {
		instance = instance,
		raw = raw_text,
		property = property,
		transform = transform,
	}
	table.insert(self._bindings, entry)
	pcall(function()
		instance.Destroying:Once(function()
			for i = #self._bindings, 1, -1 do
				if self._bindings[i].instance == instance then
					table.remove(self._bindings, i)
					break
				end
			end
		end)
	end)
	self:apply_binding(entry)
	if instance.Parent == nil then
		local parent_conn
		parent_conn = instance:GetPropertyChangedSignal('Parent'):Connect(function()
			if instance.Parent ~= nil then
				if parent_conn then
					parent_conn:Disconnect()
					parent_conn = nil
				end
				self:apply_binding(entry)
			end
		end)
	end
end

function translator:rebind(instance: Instance, raw_text: string?)
	for i = #self._bindings, 1, -1 do
		if self._bindings[i].instance == instance then
			if type(raw_text) == 'string' and raw_text ~= '' then
				self._bindings[i].raw = raw_text
				self:apply_binding(self._bindings[i])
			else
				table.remove(self._bindings, i)
			end
			return true
		end
	end
	if type(raw_text) == 'string' and raw_text ~= '' then
		self:bind(instance, raw_text)
	end
	return false
end

function translator:set_language(option: string)
	self._selected_option = option or 'Auto'
	local target_lang
	if self._selected_option == 'Auto' then
		target_lang = self:detect_locale()
	else
		target_lang = language_code_map[self._selected_option] or 'en'
	end
	self._current_lang = target_lang
	pcall(function()
		if getgenv().GG then
			getgenv().GG.SelectedLanguage = target_lang
		end
		selected_language = target_lang
	end)
	self:load_cache(target_lang)
	for i = #self._bindings, 1, -1 do
		local entry = self._bindings[i]
		local is_alive = false
		if entry.instance then
			local ok = pcall(function() return entry.instance.Parent end)
			if ok then is_alive = true end
		end
		if is_alive then
			self:apply_binding(entry)
		else
			table.remove(self._bindings, i)
		end
	end
	pcall(function()
		if library.update_keybind_list then
			library:update_keybind_list()
		end
		if library._current and library._current.update_keybind_list then
			library._current:update_keybind_list()
		end
	end)
end

function translator:init(saved_option: string?)
	local opt = saved_option or 'Auto'
	self._selected_option = opt
	local target_lang
	if opt == 'Auto' then
		target_lang = self:detect_locale()
	else
		target_lang = language_code_map[opt] or 'en'
	end
	self._current_lang = target_lang
	pcall(function()
		if getgenv().GG then
			getgenv().GG.SelectedLanguage = target_lang
		end
		selected_language = target_lang
	end)
	self:load_cache(target_lang)

	pcall(function()
		local player = players.LocalPlayer
		if localization_service and player then
			task.spawn(function()
				local ok, trans = pcall(function()
					return localization_service:GetTranslatorForPlayerAsync(player)
				end)
				if ok and trans then
					translator._roblox_translator = trans
					if translator._selected_option == 'Auto' then
						local detected = translator:detect_locale()
						if detected and detected ~= 'en' and detected ~= translator._current_lang then
							translator:set_language('Auto')
						end
					end
					pcall(function()
						trans:GetPropertyChangedSignal('LocaleId'):Connect(function()
							if translator._selected_option == 'Auto' then
								translator:set_language('Auto')
							end
						end)
					end)
				end
			end)
		end
	end)
end

