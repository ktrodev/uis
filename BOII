		local same = library._capture_flag == flag
		library._capture_cancel()
		if same then return end
	end
	local previous = library:get_keybind_name(flag)
	local closed, owner_connection = false, nil
	local function finish(name)
		if closed then return end
		closed = true
		connections:disconnect('keybind_capture')
		if owner_connection then owner_connection:Disconnect(); owner_connection = nil end
		library._capture_cancel, library._capture_flag = nil, nil
		library._choosing_keybind, lib._choosing_keybind = false, false
		pcall(display, name, false)
		pcall(lib.update_keybind_list, lib)
	end
	library._capture_flag = flag
	library._capture_cancel = function() finish(previous) end
	library._choosing_keybind, lib._choosing_keybind = true, true
	local ok, err = pcall(display, nil, true)
	if not ok then finish(previous); return false, err end
	if owner then owner_connection = owner.Destroying:Once(function() finish(previous) end) end
	connections['keybind_capture'] = user_input_service.InputBegan:Connect(function(input, processed)
		if processed or closed then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then finish(previous); return end
			if input.KeyCode == Enum.KeyCode.Unknown then return end
			if input.KeyCode == Enum.KeyCode.Backspace then library:clear_keybind(flag)
			else library:set_keybind(flag, input.KeyCode) end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			library:clear_keybind(flag)
		else return end
		finish(library:get_keybind_name(flag))
	end)
	return true
end

