function library:decode_share(code)
	if type(code) ~= 'string' or #code > share_codec.MAX_CODE_LENGTH then return nil, 'share code is too long or not text' end
	code = code:match('^%s*(.-)%s*$')
	local fenced = code:match('^```[%w_]*%s*\n(.-)\n?```$')
	if fenced then code = fenced:match('^%s*(.-)%s*$') end
	if code:sub(1, 1) == '{' or code:sub(1, 1) == '"' then
		local ok, value = pcall(function() return http_service:JSONDecode(code) end)
		if not ok then return nil, 'config is not valid JSON' end
		if type(value) == 'string' then return self:decode_share(value) end
		local data, err = clean_config(value)
		if not data then return nil, err end
		return { f = data._flags, k = data._keybinds }
	end
	code = code:gsub('[\r\n]', '')
	if code == '' then return nil, 'share code is empty' end
	local payload, checksum = code:match('^(.-)~([0-9A-Z]+)$')
	if not payload or checksum ~= share_codec.encode_base36(share_codec.checksum(payload)) then
		return nil, 'share-code checksum does not match'
	end
	local prefix = payload:match('^([^|]+)')
	if prefix ~= 'PIVOT' and prefix ~= share_codec.PREFIX then return nil, 'unsupported share-code format' end
	local decoded = { f = {}, k = {}, skipped = 0 }
	if payload == prefix then return decoded end
	local body = payload:sub(#prefix + 2)
	if body == '' or body:sub(1, 1) == '|' or body:sub(-1) == '|' or body:find('||', 1, true) then
		return nil, 'share code contains an empty record'
	end
	local seen, count = {}, 0
	for record in body:gmatch('[^|]+') do
		count += 1
		if count > share_codec.MAX_RECORDS then return nil, 'share code has too many records' end
		local kind, key, encoded = record:match('^([fk])([^=]+)=(.*)$')
		if not kind then return nil, 'share code contains a malformed record' end
		local flag, key_error
		if prefix == 'PIVOT' then flag, key_error = share_codec.unescape(key)
		else flag = self:_flag_from_share_key(key) end
		local value, err = share_codec.decode_value(encoded)
		if value == nil then return nil, err end
		local ok, cloned = pcall(function() return deep_copy_deserialize(deep_copy_serialize(value)) end)
		if not ok then return nil, tostring(cloned) end
		value = cloned
		if flag == nil and prefix == share_codec.PREFIX and key:match('^[0-9A-Z]+!?[^=]*$') then
			decoded.skipped += 1
		elseif not flag or #flag == 0 or #flag > 256 or flag:find('%c') then
			return nil, key_error or 'invalid setting name'
		else
			local id = kind .. ':' .. flag
			if seen[id] then return nil, 'share code contains a duplicate flag' end
			seen[id] = true
			local metadata = self._flag_metadata[flag]
			if self:_is_internal_flag(flag) or (metadata and (kind == 'f' and not metadata.export or kind == 'k' and not metadata.keybind_export)) then
				decoded.skipped += 1
			elseif kind == 'f' then
				if metadata and metadata.type and typeof(value) ~= metadata.type then return nil, 'wrong value type for ' .. flag end
				decoded.f[flag] = value
			elseif type(value) ~= 'string' or #value > 64 or not value:match('^[%w_]+$') then
				return nil, 'share code contains an invalid keybind'
			else decoded.k[flag] = 'Enum.KeyCode.' .. value end
		end
	end
	if next(seen) == nil and decoded.skipped > 0 then return nil, 'share code has no matching settings' end
	return decoded
end
function library:apply_config(flags, keybinds, options)
