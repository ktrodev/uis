end
local function clean_key(value: any)
	if type(value) ~= 'string' then
		return nil
	end
	local trimmed = (value:gsub('^%s+', ''):gsub('%s+$', ''))
	if trimmed == '' or #trimmed > 256 or trimmed:find('^LRM_') then
		return nil
	end
	return trimmed
end
local function get_boot_session()
	local ok, env = pcall(getgenv)
	if ok and type(env) == 'table' then
		local session = rawget(env, 'PivotBootSession')
		if type(session) == 'table' then
