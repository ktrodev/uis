local function fs_isfile(path)
	if type(isfile) ~= 'function' then
		return false
	end
	local ok, result = pcall(isfile, path)
	return ok and result == true
end
local function fs_isfolder(path)
	if type(isfolder) ~= 'function' then
		return false
	end
	local ok, result = pcall(isfolder, path)
	return ok and result == true
end
local function fs_makefolder(path)
	if type(makefolder) == 'function' and not fs_isfolder(path) then
