function Config:sanitize(name: any)
	if name == nil then
		return nil
	end
	local clean = tostring(name):gsub('[^%w %-_%.]', ''):match('^%s*(.-)%s*$')
	if clean == '' or #clean > 60 or clean:sub(1, 1) == '.' then
		return nil
	end
	return clean
end

function Config:_name(file_name: any)
	if file_name == nil or type(file_name) == 'number' or tostring(file_name) == tostring(game.GameId) then
		return self.active
	end
	return self:sanitize(file_name) or self.active
end

function Config:_path(file_name: any)
	return config_folder .. '/' .. self:_name(file_name) .. '.json'
end

function Config:_persistable_copy(config)
	local copy, err = clean_config(config or self:_empty())
	if not copy then error(err) end
	for flag in pairs(copy._flags) do
		if flag:sub(1, 10) == 'pivot_cfg_' or flag:sub(1, 9) == 'roni_cfg_'
			or self._nonpersistent_flags[flag] then copy._flags[flag] = nil end
	end
	for flag, value in pairs(copy._keybinds) do
		if type(flag) ~= 'string' or flag:sub(1, 10) == 'pivot_cfg_' or flag:sub(1, 9) == 'roni_cfg_' then
			copy._keybinds[flag] = nil
		elseif typeof(value) == 'EnumItem' then copy._keybinds[flag] = tostring(value)
		elseif type(value) ~= 'string' then error('invalid saved keybind') end
	end
	return deep_copy_serialize(copy)
end

function Config:begin_batch()
	self._batch_depth += 1
end

function Config:end_batch(file_name: any, config: any, force: boolean?)
	if self._batch_depth > 0 then
		self._batch_depth -= 1
	end
	if self._batch_depth > 0 then
		return true, 'queued'
	end
	local should_save = self._batch_dirty or force == true
	self._batch_dirty = false
	if not should_save then
		return true, 'unchanged'
	end
	return self:save(file_name, config, force)
end

function Config:_index_path()
	return config_folder .. '/_index.txt'
end

function Config:_read_index()
	local names = {}
	local raw = fs_read(self:_index_path())
	if raw then
		for line in raw:gmatch('[^\r\n]+') do
			local clean = self:sanitize(line)
			if clean then
				names[clean] = true
			end
		end
	end
	return names
end

function Config:_write_index(names: any)
	local list = {}
	for name in pairs(names) do
		list[#list + 1] = name
	end
	table.sort(list)
	fs_write(self:_index_path(), table.concat(list, '\n'))
end

function Config:_index_set(name: string, present: boolean)
	local names = self:_read_index()
	if (names[name] == true) == present then
		return
	end
	names[name] = present or nil
	self:_write_index(names)
end

function Config:save(file_name, config, force)
	if self._batch_depth > 0 then self._batch_dirty = true; return true, 'queued' end
	local name, path = self:_name(file_name), self:_path(file_name)
	local ok, encoded = pcall(function() return http_service:JSONEncode(self:_persistable_copy(config)) end)
	if not ok then return false, tostring(encoded) end
	if #encoded > 1000000 then return false, 'config is too large' end
	if self._last_encoded[path] == encoded and not self._pending_encoded[path] then return true, 'unchanged' end
	self._write_generation[path] = (self._write_generation[path] or 0) + 1
	local generation = self._write_generation[path]
	self._pending_encoded[path] = encoded
	local function write_snapshot()
		if self._write_generation[path] ~= generation then return true, 'superseded' end
		local written, err = fs_write(path, encoded)
		if not written then
			self._last_error = tostring(err)
			if force ~= true and self.on_error then pcall(self.on_error, self._last_error) end
			return false, self._last_error
		end
		self._pending_encoded[path], self._last_encoded[path] = nil, encoded
		self._last_error = nil
		if name ~= self.DEFAULT_NAME then self:_index_set(name, true) end
		return true, 'saved'
	end
	if force == true then return write_snapshot() end
	task.delay(self.SAVE_DELAY, write_snapshot)
	return true, 'queued'
end

function Config:flush(file_name)
	local targets, errors = {}, {}
	if file_name ~= nil then targets[self:_path(file_name)] = true
	else for path in pairs(self._pending_encoded) do targets[path] = true end end
	for path in pairs(targets) do
		local encoded = self._pending_encoded[path]
		if encoded then
			self._write_generation[path] = (self._write_generation[path] or 0) + 1
			local ok, err = fs_write(path, encoded)
			if ok then
				self._pending_encoded[path], self._last_encoded[path] = nil, encoded
				local name = path:match('([^/]+)%.json$')
				if name and name ~= self.DEFAULT_NAME then self:_index_set(name, true) end
			else errors[#errors + 1] = tostring(err) end
		end
	end
	self._last_error = #errors > 0 and table.concat(errors, '; ') or nil
	return #errors == 0, self._last_error
end

function Config:migrate(data, _)
	return clean_config(data)
end

function Config:_empty()
	return { _flags = {}, _keybinds = {}, _library = {} }
end

function Config:exists(file_name: any)
	return fs_isfile(self:_path(file_name))
end

function Config:load(file_name, default)
	local name, path = self:_name(file_name), self:_path(file_name)
	local raw = fs_read(path)
	if not raw and name == self.DEFAULT_NAME then
		local id = tostring(game.GameId)
		for _, legacy in ipairs({ 'pivot/' .. id .. '.json', 'Allusive/' .. id .. '.json', 'roni/' .. id .. '.json' }) do
			raw = fs_read(legacy)
			if raw then break end
		end
	end
	if raw == nil then return default and clone_config_value(default) or self:_empty() end
	if #raw == 0 or #raw > 1000000 then return nil, 'saved config is empty or too large' end
	local ok, decoded = pcall(function() return http_service:JSONDecode(raw) end)
	if not ok then return nil, 'saved config is not valid JSON' end
	local data, err = clean_config(decoded)
	if not data then return nil, err end
	self._last_encoded[path] = raw
	return data
end

function Config:list()
	local names = self:_read_index()
	local files = fs_list(config_folder)
	if files then
		local found = {}
		for _, file in ipairs(files) do
			local base = tostring(file):match('([^/\\]+)%.json$')
			local clean = base and self:sanitize(base)
			if clean and clean == base then
				local content = fs_read(self:_path(clean))
				if content == nil or content:match('%S') then
					found[clean] = true
				end
			end
		end
		names = found
	end
	names[self.DEFAULT_NAME] = nil
	local list = {}
	for name in pairs(names) do
		list[#list + 1] = name
	end
	table.sort(list, function(a, b) return a:lower() < b:lower() end)
	return list
end

function Config:delete(file_name)
	local name = self:sanitize(file_name)
	if not name then return false, 'invalid config name' end
	local path = self:_path(name)
	if not fs_delete(path) and fs_isfile(path) then
		local ok, err = fs_write(path, '')
		if not ok then return false, err end
	end
	self._pending_encoded[path], self._last_encoded[path] = nil, nil
	self._write_generation[path] = (self._write_generation[path] or 0) + 1
	self:_index_set(name, false)
	local raw_autoload = fs_read(config_folder .. '/_autoload.txt')
	if raw_autoload and self:sanitize(raw_autoload) == name then
		local ok, err = self:set_autoload(nil)
		if not ok then return false, 'config removed, but autoload could not be cleared: ' .. tostring(err) end
	end
	if self.active == name then self.active = self.DEFAULT_NAME end
	return true
end

function Config:get_autoload()
	local raw = fs_read(config_folder .. '/_autoload.txt')
	local name = raw and self:sanitize(raw)
	if name == self.DEFAULT_NAME then
		return name
	end
	if name then
		local content = fs_read(config_folder .. '/' .. name .. '.json')
		if type(content) == 'string' and content:match('%S') then
			return name
		end
	end
	return self.DEFAULT_NAME
end

function Config:set_autoload(file_name: any)
	local name = self:sanitize(file_name) or self.DEFAULT_NAME
	local ok, err = fs_write(config_folder .. '/_autoload.txt', name)
	return ok, err, name
end

