		local packed = table.pack(values, ...)
		values = {}
		for index, name in ipairs({ 'LRM_IsUserPremium', 'LRM_SecondsLeft', 'LRM_TotalExecutions', 'LRM_LinkedDiscordID', 'LRM_UserNote', 'LRM_ScriptVersion' }) do
			if packed[index] ~= nil then
				values[name] = packed[index]
			end
		end
	end
	for key, value in pairs(values) do
		local name = lrm_aliases[key] or key
		if lrm_valid(value) then
			library.Luarmor.overrides[name] = value
		end
	end
	local version = library.Luarmor.overrides.LRM_ScriptVersion
	if version ~= nil then
		library.script_version = tostring(version)
	end
	library:refresh_profile()
end
