		end
	end
	if #records > share_codec.MAX_RECORDS then error('config has too many share records') end
	table.sort(records)
	local payload = 'PIVOT' .. (#records > 0 and '|' .. table.concat(records, '|') or '')
	local code = payload .. '~' .. share_codec.encode_base36(share_codec.checksum(payload))
