		for flag in pairs(next_flags) do
			local metadata = self._flag_metadata[flag]
			if not self:_is_internal_flag(flag) and (not metadata or metadata.export) then next_flags[flag] = nil end
		end
		for flag in pairs(next_keys) do
			local metadata = self._flag_metadata[flag]
			if not self:_is_internal_flag(flag) and (not metadata or metadata.keybind_export) then next_keys[flag] = nil end
		end
		for _, flag in ipairs(self._flag_order) do
			local metadata = self._flag_metadata[flag]
			if metadata.export and not self:_is_internal_flag(flag) then next_flags[flag] = clone_config_value(metadata.default) end
			if metadata.keybind_export and not self:_is_internal_flag(flag) then next_keys[flag] = nil end
		end
	end
	local errors, skipped = {}, 0
	for flag, value in pairs(data._flags) do
		local metadata = self._flag_metadata[flag]
		if self:_is_internal_flag(flag) or (metadata and not metadata.export and not (named and metadata.persist)) then
			skipped += 1
		elseif metadata and metadata.type and typeof(value) ~= metadata.type then
			errors[#errors + 1] = 'wrong value type for ' .. flag
		elseif metadata and metadata.normalize then
			local ok, normalized = pcall(metadata.normalize, value)
			if ok then next_flags[flag] = normalized else errors[#errors + 1] = 'invalid value for ' .. flag end
		else next_flags[flag] = clone_config_value(value) end
	end
	for flag, key in pairs(data._keybinds) do
		local metadata = self._flag_metadata[flag]
		if type(flag) ~= 'string' or #flag == 0 or #flag > 256 then errors[#errors + 1] = 'invalid keybind flag'
		elseif self:_is_internal_flag(flag) or (metadata and not metadata.keybind_export and not named) then skipped += 1
		else
			local name = resolve_canonical_key_name(key)
			local empty = key == '' or key == 'None' or key == 'Unknown' or key == 'Enum.KeyCode.None' or key == 'Enum.KeyCode.Unknown'
			local ok, enum = pcall(function() return name and Enum.KeyCode[name] end)
			if empty then next_keys[flag] = 'None'
			elseif ok and enum and enum ~= Enum.KeyCode.Unknown then next_keys[flag] = 'Enum.KeyCode.' .. enum.Name
			else errors[#errors + 1] = 'invalid keybind for ' .. flag end
		end
	end
	if #errors > 0 then return { ok = false, applied = 0, errors = errors } end
	self._applying_config = true
	self._failed_callbacks = self._failed_callbacks or {}
	local previous_flags, previous_keys = self._config._flags, self._config._keybinds
	self._config._flags, self._config._keybinds = next_flags, next_keys
	local lib = resolve_library(self)
	if lib and lib._config then lib._config._flags, lib._config._keybinds = next_flags, next_keys end
	library._config._flags, library._config._keybinds = next_flags, next_keys
	local order = table.clone(self._flag_order)
	table.sort(order, function(a, b)
		local left, right = self._flag_metadata[a].priority or 100, self._flag_metadata[b].priority or 100
		if left == right then return a < b end
		return left < right
	end)
	Config:begin_batch()
	local applied = 0
