			end
		end
		self._failed_callbacks[flag] = failed or nil
	end
	local key_flags = {}
	for flag in pairs(previous_keys) do key_flags[flag] = true end
	for flag in pairs(next_keys) do key_flags[flag] = true end
	for flag in pairs(key_flags) do
		if previous_keys[flag] ~= next_keys[flag] then
			applied += 1
