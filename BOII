local function gui_parents()
	local parents, seen = {}, {}
	local function add(parent)
		if typeof(parent) == 'Instance' and not seen[parent] then
			seen[parent] = true
			parents[#parents + 1] = parent
		end
	end
	local player_gui
	pcall(function()
		local player = players.LocalPlayer
		player_gui = player and player:FindFirstChildOfClass('PlayerGui')
	end)
	local studio = false
	pcall(function() studio = run_service:IsStudio() end)
	if studio then add(player_gui) end
	if type(gethui) == 'function' then
		local ok, parent = pcall(gethui)
		if ok then add(parent) end
	end
	add(core_gui)
	add(player_gui)
	return parents
end

local function mount_gui(gui)
	local capabilities = {}
	if type(protect_gui) == 'function' then capabilities[#capabilities + 1] = protect_gui end
	if type(protectgui) == 'function' then capabilities[#capabilities + 1] = protectgui end
	local ok, syn_protect = pcall(function() return syn and syn.protect_gui end)
	if ok and type(syn_protect) == 'function' then capabilities[#capabilities + 1] = syn_protect end
	local tried = {}
	for _, protect in ipairs(capabilities) do
		if not tried[protect] then
			tried[protect] = true
			local called, result = pcall(protect, gui)
			if called and result ~= false then break end
		end
	end
	local last_error = 'no GUI parent is available'
	for _, parent in ipairs(gui_parents()) do
		local mounted, err = pcall(function() gui.Parent = parent end)
		if mounted then return true, parent end
		last_error = tostring(err)
	end
	return false, last_error
end

