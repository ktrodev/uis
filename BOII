function library:_build_profile_module(tab: any)
	if not tab or not tab.create_module then
		return
	end
	local module_frame = tab:create_module({
		title = 'Profile',
		description = 'Your Pivot key and account.',
		flag = 'pivot_profile_module',
		rich = false,
		persist = false,
		export = false,
		section = 'right'
	})
	library:fetch_profile()
	local text, info = self:_profile_lines()
	local profile = module_frame:create_text({ text = text })
	self._profile_text = profile
	module_frame:create_feature({
		title = 'Copy Get-Key Link',
		flag = 'pivot_profile_key',
		disablecheck = true,
		button_callback = function()
			local ok = self:set_clipboard(library.Luarmor.get_key_url)
			self.SendNotification({ title = 'Profile', text = ok and 'Get-Key link copied.' or library.Luarmor.get_key_url, type = ok and 'success' or 'info', duration = 4 })
		end
	})
	module_frame:create_feature({
		title = 'Copy Discord',
		flag = 'pivot_profile_discord',
		disablecheck = true,
		button_callback = function()
			local ok = self:set_clipboard(library.Luarmor.discord)
			self.SendNotification({ title = 'Profile', text = ok and 'Discord invite copied.' or library.Luarmor.discord, type = ok and 'success' or 'info', duration = 4 })
		end
	})
	module_frame:create_feature({
		title = 'Reset Saved Key',
		flag = 'pivot_profile_reset',
		disablecheck = true,
		button_callback = function()
			local removed = self:reset_saved_key()
			self.SendNotification({ title = 'Profile', text = removed > 0 and 'Saved key removed. Re-execute to enter a new key.' or 'Key cleared for this session. No saved key file found.', type = 'success', duration = 5 })
		end
	})
	local timer_running = false
	self._start_profile_timer = function()
		if timer_running then
			return
		end
		timer_running = true
		task.spawn(function()
			local last = nil
			while self._ui and self._profile_text == profile do
				if self._ui_open ~= false then
					local new_text, now_info = self:_profile_lines()
					if new_text ~= last then
						last = new_text
						pcall(function() profile:Set({ text = new_text }) end)
					end
					if now_info.seconds_left == nil or now_info.lifetime or now_info.seconds_left <= 0 then
						break
					end
				end
				task.wait(1)
			end
			timer_running = false
		end)
	end
	if info.seconds_left ~= nil and not info.lifetime then
		self._start_profile_timer()
	end
end
