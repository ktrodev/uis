	end
	connections:disconnect('library_visiblity')
	connections['library_visiblity'] = user_input_service.InputBegan:Connect(function(input: InputObject, process: boolean)
		if library._choosing_keybind or user_input_service:GetFocusedTextBox() then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		local current_toggle = self:get_toggle_keycode()
		local is_match = false

		if current_toggle and input.KeyCode == current_toggle then
			is_match = true
		elseif library:keybind_matches('ui_toggle_key', input) then
			is_match = true
		elseif library:keybind_matches('minimize_bind', input) then
			is_match = true
		elseif library:keybind_matches('minimize', input) then
			is_match = true
		end

		if not is_match then
			return
		end

		self:Minimize()
	end)
	self._ui.Container.Handler.Minimize.MouseButton1Click:Connect(function()
		self:Minimize()
	end)
	connections:disconnect('mobile_toggle_input_ended')
	connections:disconnect('mobile_toggle_drag')
	connections:disconnect('mobile_toggle_viewport')
	if self._is_mobile or user_input_service.TouchEnabled then
		local _toggle_gui = create_new('ScreenGui', {
			Name = '_pivot_toggle',
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		})
		local mounted, mount_error = mount_gui(_toggle_gui)
		if not mounted then self._gui_parent_error = mount_error end
		self._toggle_gui = _toggle_gui

		local mobile_toggle = create_new('TextButton', {
			Name = 'MobileToggle',
			Size = UDim2.new(0, 42, 0, 42),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(20, 20, 20),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = '',
			ZIndex = 100,
			Visible = true,
			Parent = _toggle_gui,
		})

		local ui_corner = create_new('UICorner', {
			CornerRadius = UDim.new(0, 8),
			Parent = mobile_toggle,
		})

		local ui_stroke = create_new('UIStroke', {
			Color = Color3.fromRGB(48, 48, 48),
			Transparency = 0.2,
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = mobile_toggle,
		})

		local toggle_icon = create_new('ImageLabel', {
			Name = 'ToggleIcon',
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 26, 0, 26),
			Image = 'rbxassetid://86490552961317',
			ImageColor3 = Color3.fromRGB(255, 255, 255),
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 101,
			Parent = mobile_toggle,
		})

		library._config._library = library._config._library or {}
		local saved_pos = library._config._library._mobile_toggle_pos
		local function valid_position_component(value: any)
			return type(value) == 'number' and value == value and math.abs(value) < math.huge
		end
		local saved_position_valid = type(saved_pos) == 'table'
			and valid_position_component(saved_pos[1])
			and valid_position_component(saved_pos[2])
			and valid_position_component(saved_pos[3])
			and valid_position_component(saved_pos[4])
		mobile_toggle.Position = saved_position_valid
			and UDim2.new(saved_pos[1], saved_pos[2], saved_pos[3], saved_pos[4])
			or UDim2.new(0.5, 0, 0, 12)

		local mobile_toggle_scale = Instance.new('UIScale')
		mobile_toggle_scale.Parent = mobile_toggle
		self._mobile_toggle_uiscale = mobile_toggle_scale
		mobile_toggle_scale.Scale = self._ui_scale or 1

		local drag_threshold = 6
		local dragging = false
		local drag_moved = false
		local drag_start, start_pos
		local active_input = nil
		local function clamp_position(pos)
			local viewport = workspace.CurrentCamera.ViewportSize
			local size = mobile_toggle.AbsoluteSize
			local width = size.X > 0 and size.X or mobile_toggle.Size.X.Offset
			local height = size.Y > 0 and size.Y or mobile_toggle.Size.Y.Offset
			local margin = 12
			local half_w = width / 2
			local min_x = margin + half_w
			local max_x = viewport.X - margin - half_w
			local min_y = margin
			local max_y = viewport.Y - height - margin
			local absolute_x = pos.X.Scale * viewport.X + pos.X.Offset
			local absolute_y = pos.Y.Scale * viewport.Y + pos.Y.Offset
			local x = math.clamp(absolute_x, min_x, math.max(min_x, max_x))
			local y = math.clamp(absolute_y, min_y, math.max(min_y, max_y))
			return UDim2.new(0, x, 0, y)
		end
		local function save_mobile_position(position)
			local serialized = {
				position.X.Scale, position.X.Offset,
				position.Y.Scale, position.Y.Offset
			}
			if library:values_equal(library._config._library._mobile_toggle_pos, serialized) then
				return
			end
			library._config._library._mobile_toggle_pos = serialized
			Config:save(game.GameId, library._config)
		end
		local function clamp_mobile_position(persist: boolean)
			if not mobile_toggle.Parent then
				return
			end
			local clamped = clamp_position(mobile_toggle.Position)
			mobile_toggle.Position = clamped
			if persist then
				save_mobile_position(clamped)
			end
		end
		task.defer(function()
			clamp_mobile_position(saved_pos ~= nil)
		end)
		local viewport_update_token = 0
		connections:disconnect('mobile_toggle_viewport')
		connections['mobile_toggle_viewport'] = workspace.CurrentCamera:GetPropertyChangedSignal('ViewportSize'):Connect(function()
			viewport_update_token += 1
			local update_token = viewport_update_token
			clamp_mobile_position(false)
			task.delay(0.2, function()
				if update_token == viewport_update_token and mobile_toggle.Parent then
					save_mobile_position(mobile_toggle.Position)
				end
			end)
		end)
		mobile_toggle.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
				dragging = true
				drag_moved = false
				drag_start = input.Position
				start_pos = mobile_toggle.Position
				active_input = input
				create_tween(mobile_toggle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundColor3 = Color3.fromRGB(32, 32, 32)
				}):Play()
				connections:disconnect('mobile_toggle_input_ended')
				connections['mobile_toggle_input_ended'] = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
						dragging = false
						active_input = nil
						create_tween(mobile_toggle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							BackgroundColor3 = Color3.fromRGB(20, 20, 20)
						}):Play()
						connections:disconnect('mobile_toggle_input_ended')
						if drag_moved then
							clamp_mobile_position(true)
						end
					end
				end)
			end
		end)
		connections:disconnect('mobile_toggle_drag')
		connections['mobile_toggle_drag'] = user_input_service.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.Touch and input ~= active_input then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - drag_start
				if delta.Magnitude >= drag_threshold then
					drag_moved = true
				end
				if drag_moved then
					local next_pos = UDim2.new(start_pos.X.Scale, start_pos.X.Offset + delta.X, start_pos.Y.Scale, start_pos.Y.Offset + delta.Y)
					mobile_toggle.Position = clamp_position(next_pos)
				end
			end
		end)
		mobile_toggle.Activated:Connect(function()
			if drag_moved then
				return
			end
			self._ui_open = not self._ui_open
			self:change_visiblity(self._ui_open)
			create_tween(toggle_icon, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 18, 0, 18)
			}):Play()
			task.delay(0.12, function()
				create_tween(toggle_icon, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Size = UDim2.new(0, 26, 0, 26)
				}):Play()
			end)
		end)
	end
	self:removed(function()
		library._choosing_keybind = false
		if self._toggle_gui then
			pcall(function() self._toggle_gui:Destroy() end)
			self._toggle_gui = nil
		end
	end)
	return self
end
return library
