function library:get_luarmor_info()
	local env = getgenv()
	local status_values = {}
	if type(env) == 'table' then
		lrm_from_status_data(rawget(env, 'PivotLuarmor'), status_values)
	end
	lrm_from_status_data(library.Luarmor.remote, status_values)
	local function read(name)
		local value = library.Luarmor.overrides[name]
		if value == nil then value = library.Luarmor.captured[name] end
		if value == nil and type(env) == 'table' then
			local ok, v = pcall(rawget, env, name)
			if ok and lrm_valid(v) then value = v end
		end
		if value == nil then
			local ok, v = pcall(rawget, _G, name)
			if ok and lrm_valid(v) then value = v end
		end
		if value == nil then value = status_values[name] end
		return value
	end
	local premium = read('LRM_IsUserPremium')
	if premium == nil and type(env) == 'table' and type(rawget(env, 'PivotPremium')) == 'boolean' then
		premium = rawget(env, 'PivotPremium')
	end
	if type(premium) == 'number' then premium = premium ~= 0 end
	if type(premium) == 'string' then premium = premium == 'true' or premium == '1' end
	local session = get_boot_session()
	local remote = library.Luarmor.remote
	local tier = (type(remote) == 'table' and type(remote.tier) == 'string' and remote.tier) or (session and type(session.tier) == 'string' and session.tier) or nil
	if premium == nil and tier == 'premium' then
		premium = true
	elseif premium == nil and tier == 'free' then
		premium = false
	end
	local seconds = tonumber(read('LRM_SecondsLeft'))
	local expires_at = nil
	if seconds and seconds ~= math.huge and seconds == seconds then
		local cache = library.Luarmor._expiry_cache
		if not cache or cache.raw ~= seconds then
			cache = { raw = seconds, at = os.time() + seconds }
			library.Luarmor._expiry_cache = cache
		end
		expires_at = cache.at
		seconds = math.max(0, expires_at - os.time())
	end
	local version = read('LRM_ScriptVersion') or library.script_version
	if type(env) == 'table' and rawget(env, 'PIVOT_VERSION') ~= nil then
		version = rawget(env, 'PIVOT_VERSION')
	end
	local note = read('LRM_UserNote')
	local discord_id = read('LRM_LinkedDiscordID')
	local saved_key, key_source = library:get_saved_key()
	return {
		tier = tier,
		key = saved_key,
		key_source = key_source,
		remote_state = library.Luarmor.remote_state,
		available = premium ~= nil or seconds ~= nil,
		premium = premium == true,
		premium_known = premium ~= nil,
		seconds_left = seconds,
		lifetime = seconds ~= nil and (seconds == math.huge or seconds > 3153600000),
		expires_at = expires_at,
		executions = tonumber(read('LRM_TotalExecutions')),
		discord_id = discord_id ~= nil and tostring(discord_id) or nil,
		note = note ~= nil and tostring(note) or nil,
		script_name = read('LRM_ScriptName'),
		version = tostring(version),
	}
end
function library:format_time_left(seconds: any)
	seconds = tonumber(seconds)
	if not seconds then
		return 'Unknown'
	end
	if seconds == math.huge or seconds > 3153600000 then
		return 'Lifetime'
	end
	if seconds <= 0 then
		return 'Expired'
	end
	seconds = math.floor(seconds)
	local d = math.floor(seconds / 86400)
	local h = math.floor(seconds % 86400 / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if d > 0 then
		return string.format('%dd %02dh %02dm', d, h, m)
	end
	return string.format('%02dh %02dm %02ds', h, m, s)
end
function library:reset_saved_key()
	local removed = 0
	for _, path in ipairs(library.Luarmor.key_files) do
		if fs_delete(path) then
			removed += 1
		elseif fs_isfile(path) then
			if fs_write(path, '') then
				removed += 1
			end
		end
	end
	local env = getgenv()
	if type(env) == 'table' then
		for _, name in ipairs(library.Luarmor.key_globals) do
			pcall(function()
				env[name] = nil
			end)
		end
		env.PivotKeySystemLoaded = nil
		env.PivotPremium = nil
		local session = rawget(env, 'PivotBootSession')
		if type(session) == 'table' then
			session.key = nil
		end
	end
	pcall(function()
		for _, name in ipairs(library.Luarmor.key_globals) do
			_G[name] = nil
		end
	end)
	pcall(function()
		script_key = nil
	end)
	library.Luarmor.remote = nil
	library.Luarmor.remote_state = 'idle'
	library:refresh_profile()
	return removed
end
function library:_profile_lines()
	local info = self:get_luarmor_info()
	local plan = info.premium_known and (info.premium and 'Premium' or 'Free') or (info.tier == 'guest' and 'Guest' or 'Unknown')
	local pending = info.remote_state == 'loading'
	local expiry
	if info.seconds_left == nil then
		expiry = pending and 'Checking...' or 'Unknown'
	elseif info.lifetime then
		expiry = 'Lifetime'
	else
		expiry = self:format_time_left(info.expires_at - os.time())
	end
	local key_text = 'Not found'
	if info.key then
		key_text = #info.key > 4 and ('****' .. info.key:sub(-4)) or '****'
	end
	local lines = {
		'Plan: ' .. plan,
		'Key: ' .. key_text,
		'Key expires in: ' .. expiry,
		'Executions: ' .. (info.executions and tostring(info.executions) or (pending and 'Checking...' or '-')),
		'Discord ID: ' .. (info.discord_id or (pending and 'Checking...' or 'Not linked')),
		'Note: ' .. ((info.note and info.note ~= '') and info.note or '-'),
		'Version: ' .. tostring(info.version),
	}
	return table.concat(lines, '\n'), info
end
