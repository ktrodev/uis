	local existing = self._flag_metadata[flag]
	if not existing then existing = {}; self._flag_metadata[flag] = existing; table.insert(self._flag_order, flag) end
	if expected_type ~= nil then self._registered_flags[flag], existing.type = expected_type, expected_type end
	if metadata.default ~= nil or existing.default == nil then existing.default = clone_config_value(metadata.default) end
	if metadata.normalize then existing.normalize = metadata.normalize end
	for _, key in ipairs({ 'persist', 'export', 'keybind_export' }) do
		if metadata[key] ~= nil then existing[key] = metadata[key] == true end
	end
	if existing.persist == nil then existing.persist = true end
	if existing.export == nil then existing.export = existing.persist and not self:_is_internal_flag(flag) end
	if existing.keybind_export == nil then existing.keybind_export = existing.export end
