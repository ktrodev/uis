function library:get_saved_key()
	local session = get_boot_session()
	if session then
		local key = clean_key(session.key)
		if key then
			return key, 'session'
		end
	end
	local ok_global, global_key = pcall(function()
		return script_key
	end)
	if ok_global then
		local key = clean_key(global_key)
		if key then
			return key, 'global'
		end
	end
	local ok_env, env = pcall(getgenv)
	for _, container in ipairs({ ok_env and env or nil, _G }) do
		if type(container) == 'table' then
			for _, name in ipairs(library.Luarmor.key_globals) do
				local ok, value = pcall(rawget, container, name)
				local key = ok and clean_key(value) or nil
				if key then
					return key, container == _G and '_G' or 'genv'
				end
			end
		end
	end
	for _, path in ipairs(library.Luarmor.key_files) do
		local key = clean_key(fs_read(path))
		if key then
			return key, path
		end
	end
